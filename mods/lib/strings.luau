local strings = {}

strings.text = text

--- Option name: the mod's own text, else the shared `opt.*`, else the value itself.
function strings.option(scope: string, key: string, value: string): string
	return text[`{scope}.{key}.{value}`] or text["opt." .. value] or value
end

return strings
